ENV=dev
LOG_LEVEL=INFO

POSTGRES_DB=mobility
POSTGRES_USER=mobility
POSTGRES_PASSWORD=mobility
DATABASE_URL=postgresql+psycopg://mobility:mobility@db:5432/mobility

DEFAULT_AREA_LAT=48.8566
DEFAULT_AREA_LON=2.3522

# --- Source OpenDataSoft (trafic réel) ---
# Exemple Paris : dataset "comptages-routiers-permanents"
ODS_DOMAIN=opendata.paris.fr
ODS_DATASET=
ODS_API_KEY=
# Noms de champs du dataset (défauts calés sur comptages-routiers-permanents)
ODS_FIELD_TS=t_1h
ODS_FIELD_FLOW=q
ODS_FIELD_OCC=k

# --- Sécurité / API ---
# Origines CORS autorisées (CSV). "*" = tout autoriser (dev uniquement).
CORS_ORIGINS=*
# Si défini, requis dans l'en-tête X-API-Key pour les écritures (POST).
API_KEY=
# Limites de débit (format flask-limiter).
RATE_LIMIT_DEFAULT=200 per minute
RATE_LIMIT_WRITE=20 per minute
MAX_PAGE_LIMIT=500

# --- Itinéraire (géocodage + routage) ---
# Services externes (nécessitent un accès internet). Serveurs de démo par défaut.
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
OSRM_URL=http://router.project-osrm.org
ROUTING_USER_AGENT=mobilite-projet-etude/1.0 (projet etudiant)
# Pénalité de temps : durée_segment x (1 + penalty x congestion). 1.0 => +100% si saturé.
ROUTE_CONGESTION_PENALTY=1.0

# --- Simulation what-if ---
# Exposant de sensibilité : congestion x (1 - reduction)^beta. <1 = effet atténué.
SIMULATION_BETA=0.8
